#!/usr/bin/env python3
"""ccb-profile-apply: copy a CCB workflow profile bundle into a project.

Usage:
  ccb-profile-apply --name <profile> [--force] [--dry-run] [--target DIR]
  ccb-profile-apply --list
"""
from __future__ import annotations

import argparse
import shutil
import sys
from pathlib import Path

GITIGNORE_BEGIN_FMT = "# >>> ccb-profile {name}"
GITIGNORE_END_FMT = "# <<< ccb-profile {name}"


def find_profiles_dir(script_path: Path) -> Path:
    candidate = script_path.resolve().parent.parent / "config" / "profiles"
    if candidate.is_dir():
        return candidate
    raise FileNotFoundError(f"profiles dir not found near {script_path}")


def list_profiles(profiles_dir: Path) -> list[str]:
    return sorted(p.name for p in profiles_dir.iterdir() if p.is_dir())


def merge_gitignore(src: Path, dst: Path, *, name: str, dry_run: bool) -> str:
    begin = GITIGNORE_BEGIN_FMT.format(name=name)
    end = GITIGNORE_END_FMT.format(name=name)
    existing = dst.read_text(encoding="utf-8") if dst.exists() else ""
    if begin in existing:
        return f"skipped (gitignore block already present): {dst}"
    fragment = src.read_text(encoding="utf-8").rstrip() + "\n"
    block = f"{begin}\n{fragment}{end}\n"
    if dry_run:
        return f"would append gitignore block: {dst}"
    with dst.open("a", encoding="utf-8") as f:
        if existing and not existing.endswith("\n"):
            f.write("\n")
        if existing:
            f.write("\n")
        f.write(block)
    return f"appended gitignore block: {dst}"


def apply_profile(*, name: str, profile_dir: Path, target: Path, force: bool, dry_run: bool) -> int:
    if not profile_dir.is_dir():
        print(f"error: profile not found: {profile_dir}", file=sys.stderr)
        return 1
    target.mkdir(parents=True, exist_ok=True)
    errors: list[str] = []
    for src in sorted(profile_dir.iterdir()):
        if src.name == "README.md":
            continue
        if src.name == "gitignore.fragment":
            print(merge_gitignore(src, target / ".gitignore", name=name, dry_run=dry_run))
            continue
        if src.name == "ccb.config":
            dst = target / ".ccb" / "ccb.config"
        else:
            dst = target / src.name
        if dst.exists() and not force:
            print(f"skipped (exists, --force to overwrite): {dst}")
            continue
        if dry_run:
            print(f"would write: {dst}")
            continue
        try:
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(src, dst)
            print(f"wrote: {dst}")
        except OSError as exc:
            errors.append(f"failed: {dst}: {exc}")
    for line in errors:
        print(line, file=sys.stderr)
    return 1 if errors else 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="ccb-profile-apply")
    parser.add_argument("--name")
    parser.add_argument("--list", action="store_true")
    parser.add_argument("--target", default=".")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--dry-run", action="store_true")
    args = parser.parse_args(argv)
    try:
        profiles_dir = find_profiles_dir(Path(__file__))
    except FileNotFoundError as exc:
        print(f"error: {exc}", file=sys.stderr)
        return 1
    if args.list:
        for n in list_profiles(profiles_dir):
            print(n)
        return 0
    if not args.name:
        print("error: --name is required (or use --list)", file=sys.stderr)
        return 1
    return apply_profile(
        name=args.name,
        profile_dir=profiles_dir / args.name,
        target=Path(args.target).resolve(),
        force=args.force,
        dry_run=args.dry_run,
    )


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
